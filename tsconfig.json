{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "coverage"],
  "include": [
    "src/**/*",
    "test/**/*",
    "packages/cli/bin/**/*.js",
    "packages/cli/lib/**/*.js",
    "node_modules/@cloudflare/vitest-pool-workers/types/**/*"
  ]
}
